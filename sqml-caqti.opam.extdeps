opam-version: "2.0"
name: "sqml-caqti"
version: "0.10.3"
synopsis: "SQML Caqti backend engine."
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "GPLv3"
homepage: "https://github.com/mefyl/sqml"
bug-reports: "https://github.com/mefyl/sqml/issues"
depends: [
  "ocamlformat" {= "0.25.1"}
  "opam-file-format"
  "sexplib"
  "shexp"
  "angstrom" {= "0.15.0"}
  "base" {= "v0.15.1"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bigstringaf" {= "0.9.1"}
  "caqti" {= "1.8.0"}
  "caqti-driver-postgresql" {= "1.8.0" & with-test}
  "caqti-driver-sqlite3" {= "1.8.0" & with-test}
  "caqti-lwt" {= "1.8.0"}
  "cmdliner" {= "1.2.0"}
  "conf-pkg-config" {= "2"}
  "conf-postgresql" {= "1" & with-test}
  "conf-sqlite3" {= "1"}
  "cppo" {= "1.6.9"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "dune" {= "3.8.1"}
  "dune-configurator" {= "3.8.1"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.9.0"}
  "hex" {= "1.5.0"}
  "jsonm" {= "1.0.2"}
  "logs" {= "0.7.0"}
  "lwt" {= "5.6.1"}
  "metapp" {= "0.4.4"}
  "ocaml" {= "4.14.1"}
  "ocaml-base-compiler" {= "4.14.1"}
  "ocaml-compiler-libs" {= "v0.12.4"}
  "ocaml-config" {= "2"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.14.2"}
  "ocamlfind" {= "1.9.6"}
  "ocplib-endian" {= "1.2"}
  "postgresql" {= "5.0.0" & with-test}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "5.2.1"}
  "ppx_here" {= "v0.15.0"}
  "ppx_sexp_conv" {= "v0.15.1"}
  "ppxlib" {= "0.29.1"}
  "ptime" {= "1.1.0"}
  "result" {= "1.5"}
  "semver2" {= "1.2.0"}
  "seq" {= "base"}
  "sexplib0" {= "v0.15.1"}
  "sqlite3" {= "5.1.0"}
  "stdcompat" {= "19"}
  "stdlib-shims" {= "0.3.0"}
  "stringext" {= "1.6.0"}
  "topkg" {= "1.0.7"}
  "uchar" {= "0.0.2"}
  "uri" {= "4.2.0"}
  "uutf" {= "1.0.3"}
]
dev-repo: "git+https://github.com/mefyl/sqml.git"
