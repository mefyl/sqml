(dirs :standard .logistic)

(alias
 (name default)
 (deps
  sqml.opam
  sqml-caqti.opam
  (alias_rec lib/default)
  (alias_rec engines/default)))

(rule
 (target dune.extdeps.inc)
 (alias extdeps)
 (mode (promote))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:.logistic/dune/extdeps/extdeps.exe}
    generate
    --exclude
    acid,hlist,timmy))))

(include dune.extdeps.inc)
