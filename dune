(alias
 (name default)
 (deps
  sqml.opam
  sqml-caqti.opam
  (alias_rec lib/default)
  (alias_rec engines/default)))

(rule
 (target sqml.%{version:sqml}.opam)
 (deps
  (:opam sqml.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/sqml#%{version:sqml}\"\n}\n")))))

(rule
 (target sqml-caqti.%{version:sqml-caqti}.opam)
 (deps
  (:opam sqml-caqti.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (echo
     "url {\n  src: \"git://git@gitlab.routine.co:routine/sqml#%{version:sqml-caqti}\"\n}\n")))))

(rule
 (deps (universe))
 (target sqml.opam.locked)
 (action
  (run %{bin:opam} lock sqml)))

(rule
 (mode
  (promote (until-clean)))
 (target sqml.opam.extdeps)
 (alias extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(acid|ocaml|sqml|schematic|timmy)/ { print($0) }"
    %{dep:sqml.opam.locked}))))

(rule
 (deps (universe))
 (target sqml-caqti.opam.locked)
 (action
  (run %{bin:opam} lock sqml-caqti)))

(rule
 (mode
  (promote (until-clean)))
 (target sqml-caqti.opam.extdeps)
 (alias extdeps)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:awk}
    "/^build: / { exit 0 }; !/^  \"(acid|ocaml|schematic|sqml|timmy)/ { print($0) }"
    %{dep:sqml-caqti.opam.locked}))))
