(version 1.2.1)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune base fmt ocaml ppx_here ppx_deriving ptime schematic)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/timmy#413f24e5a728786bc7758ce3cdc08fb94203fe1f)))

(dev)
