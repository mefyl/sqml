(version 5.4.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml dune-compiledb dune-configurator conf-sqlite3)))

(source
 (fetch
  (url
   https://github.com/mmottl/sqlite3-ocaml/releases/download/5.4.0/sqlite3-5.4.0.tbz)
  (checksum
   sha512=3ab7eb7a41e13a8448ce58dec388dee90fe7a18681323266ac14d2bd5b97c601b25f9b8ab60afa4f507b6ce13792f791e4b78bab1b0747b28097da273ff5a737)))
