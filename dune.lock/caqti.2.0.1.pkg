(version 2.0.1)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (angstrom
   bigstringaf
   domain-name
   dune
   ipaddr
   logs
   lwt-dllist
   mtime
   ocaml
   ptime
   uri)))

(source
 (fetch
  (url
   https://github.com/paurkedal/ocaml-caqti/releases/download/v2.0.1/caqti-v2.0.1.tbz)
  (checksum
   sha256=7eb57225c521fe25395653d960b1c381bb2b2ccae47bc2a827bb16611988da8b)))
