(version 0.1.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune fmt hmap logs ocaml uuidm lwt)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/stere#7262594787266a9f05aaa04742195a8fea61bb64)))

(dev)
