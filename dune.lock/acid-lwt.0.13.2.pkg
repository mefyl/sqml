(version 0.13.2)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune acid lwt ppx_deriving)))

(source
 (fetch
  (url
   git+ssh://git@gitlab.routine.co/routine/acid#8574c623b6d7ad26aaf5e931a759611fa54a2b93)))

(dev)
