opam-version: "2.0"
name: "sqml"
version: "0.10.7"
synopsis: "Type safe SQL queries."
maintainer: "mefyl <mefyl@gruntech.org>"
authors: "mefyl <mefyl@gruntech.org>"
license: "GPLv3"
homepage: "https://github.com/mefyl/sqml"
bug-reports: "https://github.com/mefyl/sqml/issues"
depends: [
  "ocamlformat" {= "0.26.1"}
  "opam-file-format"
  "sexplib"
  "alcotest" {= "1.7.0" & with-test}
  "alcotest-lwt" {= "1.7.0" & with-test}
  "angstrom" {= "0.16.0"}
  "astring" {= "0.8.5" & with-test}
  "base" {= "v0.16.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "bigstringaf" {= "0.9.1"}
  "cmdliner" {= "1.2.0"}
  "conf-autoconf" {= "0.1"}
  "conf-which" {= "1"}
  "cppo" {= "1.6.9"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "dune" {= "3.12.1"}
  "dune-configurator" {= "3.12.1"}
  "ezjsonm" {= "1.3.0"}
  "fmt" {= "0.9.0"}
  "hex" {= "1.5.0"}
  "jsonm" {= "1.0.2"}
  "logs" {= "0.7.0"}
  "lwt" {= "5.7.0"}
  "metapp" {= "0.4.4"}
  "ocaml" {= "5.1.1"}
  "ocaml-base-compiler" {= "5.1.1"}
  "ocaml-compiler-libs" {= "v0.12.4"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0"}
  "ocamlbuild" {= "0.14.3"}
  "ocamlfind" {= "1.9.6"}
  "ocplib-endian" {= "1.2"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "5.2.1"}
  "ppx_here" {= "v0.16.0"}
  "ppx_sexp_conv" {= "v0.16.0"}
  "ppxlib" {= "0.31.0"}
  "ptime" {= "1.1.0"}
  "re" {= "1.11.0" & with-test}
  "result" {= "1.5"}
  "semver2" {= "1.2.0"}
  "seq" {= "base"}
  "sexplib0" {= "v0.16.0"}
  "stdcompat" {= "19"}
  "stdlib-shims" {= "0.3.0"}
  "topkg" {= "1.0.7"}
  "uutf" {= "1.0.3"}
]
dev-repo: "git+https://github.com/mefyl/sqml.git"
