(rule
 (target sqml.%{version:sqml}.opam)
 (deps
  (:opam ../sqml.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run git log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/sqml#%H\" }"
     -n1)))))

