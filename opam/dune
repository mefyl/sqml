(alias
 (name default)
 (deps))

(rule
 (target sqml.%{version:sqml}.opam)
 (deps
  (:opam ../sqml.opam))
 (action
  (with-stdout-to
   %{target}
   (progn
    (cat %{opam})
    (run
     git
     log
     "--pretty=url { src: \"git://git@gitlab.routine.co:routine/sqml#%H\" }"
     -n1)))))

(rule
 (target sqml-ios.opam)
 (mode
  (promote (until-clean)))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:../.logistic/ci/dune/dune_sak.exe}
    rewrite-ios
    --input
    %{dep:../sqml.opam}
    --cross
    sqml,sqml-caqti
    --cross-both
    ""
    --cross-exclude
    ""))))

